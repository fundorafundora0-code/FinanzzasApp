      <section class="card">
        <div class="card-head"><h3>Global</h3><span class="muted">${s.globalBudget ? fmt(s.globalBudget) : 'No definido'}</span></div>
        ${s.globalBudget
          ? progressBar(Store.monthTotals(month).expense, s.globalBudget)
          : '<p class="muted">Define un presupuesto global mensual para controlar tu gasto total.</p>'}
      </section>
      <section class="card">
        <div class="card-head"><h3>Categorías con presupuesto</h3>
          <span class="muted">${fmt(totalSpent)} de ${fmt(totalBudget)}</span></div>
