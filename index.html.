/* ============ 7) APP ============ */
const App = (function () {
  const NAV = [
    { key: 'dashboard',  label: 'Dashboard',     icon: '📊' },
    { key: 'incomes',    label: 'Ingresos',      icon: '💰' },
    { key: 'expenses',   label: 'Gastos',        icon: '💸' },
    { key: 'categories', label: 'Categorías',    icon: '🏷️' },
    { key: 'budgets',    label: 'Presupuestos',  icon: '🎯' },
    { key: 'reports',    label: 'Reportes',      icon: '📈' },
    { key: 'settings',   label: 'Configuración', icon: '⚙️' }
  ];
  const ROUTES = {
    dashboard:  () => Views.dashboard,
    incomes:    () => Views.income,
    expenses:   () => Views.expense,
    categories: () => Views.categories,
    budgets:    () => Views.budgets,
    reports:    () => Views.reports,
    settings:   () => Views.settings
  };
  let currentRoute = 'dashboard';

  function buildNav() {
    const html = NAV.map(n =>
      `<a class="nav-item" href="#${n.key}" data-route="${n.key}">
        <span class="nav-icon">${n.icon}</span>
        <span class="nav-label">${n.label}</span>
      </a>`).join('');
    document.getElementById('desktop-nav').innerHTML = html;
    document.getElementById('bottom-nav').innerHTML = html;
  }
  function setActive(route) {
    document.querySelectorAll('.nav-item').forEach(el => {
      const isActive = el.dataset.route === route;
      el.classList.toggle('active', isActive);
      if (isActive) el.setAttribute('aria-current', 'page');
      else el.removeAttribute('aria-current');
    });
  }
  function applyTheme() {
    document.documentElement.setAttribute('data-theme', Store.getSettings().theme || 'light');
  }
  function render() {
    const main = document.getElementById('main');
    const route = (location.hash || '#dashboard').slice(1).split('?')[0] || 'dashboard';
    currentRoute = ROUTES[route] ? route : 'dashboard';
    setActive(currentRoute);
    main.innerHTML = '';
    window.scrollTo({ top: 0 });
    try { ROUTES[currentRoute]().render(main); }
    catch (e) {
      console.error('FinTrack render error:', e);
      main.innerHTML = `<div class="card"><h2>Algo salió mal</h2>
        <p class="muted">${Utils.escapeHtml(e.message || 'Error desconocido')}</p></div>`;
    }
  }
  function refresh() {
    const active = document.activeElement;
    const fkey = active && active.dataset ? active.dataset.filter : null;
    const selStart = active && typeof active.selectionStart === 'number' ? active.selectionStart : null;
    render();
    if (fkey) {
      const el = document.querySelector(`[data-filter="${fkey}"]`);
      if (el) {
        el.focus();
        if (selStart != null && el.setSelectionRange) {
          try { el.setSelectionRange(selStart, selStart); } catch (e) { /* noop */ }
        }
      }
    }
  }
  function setupShortcuts() {
    document.addEventListener('keydown', e => {
      const tag = (e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select' || e.target.isContentEditable) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.querySelector('.modal-overlay')) return;
      const k = e.key.toLowerCase();
      if (k === 'n') { e.preventDefault(); Forms.transactionForm({ type: 'income', onSaved: refresh }); }
      else if (k === 'g') { e.preventDefault(); Forms.transactionForm({ type: 'expense', onSaved: refresh }); }
      else if (k === '/') {
        e.preventDefault();
        const search = document.querySelector('[data-filter="q"]');
        if (search) search.focus();
        else if (currentRoute === 'dashboard') location.hash = '#expenses';
      }
    });
  }
  function boot() {
    try { Store.init(); }
    catch (e) { console.error(e); UI.toast('Error al cargar los datos', 'error'); }
    applyTheme();
    buildNav();
    setupShortcuts();
    try {
      const created = Store.processRecurring();
      if (created) UI.toast(`${created} transacción(es) recurrente(s) registrada(s)`, 'info');
    } catch (e) { console.error(e); }
    window.addEventListener('hashchange', render);
    window.addEventListener('resize', Utils.debounce(() => {
      if (currentRoute === 'dashboard') refresh();
    }, 250));
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const next = Store.getSettings().theme === 'dark' ? 'light' : 'dark';
        Store.updateSettings({ theme: next });
        applyTheme(); refresh();
      });
    }
    if (!location.hash) location.hash = '#dashboard';
    render();
  }
  return { boot, refresh, applyTheme, render };
})();

/* Arranque */
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', App.boot);
else App.boot();

})();
</script>
