<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#2563eb">
<title>FinTrack — Finanzas personales</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E💰%3C/text%3E%3C/svg%3E">
<style>
/* ============ Base ============ */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

:root {
  --bg: #f6f8fb;
  --surface: #ffffff;
  --surface-2: #f1f5f9;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --primary: #2563eb;
  --primary-fg: #ffffff;
  --income: #16a34a;
  --expense: #dc2626;
  --warning: #f59e0b;
  --danger: #dc2626;
  --radius: 14px;
  --radius-sm: 10px;
  --shadow-sm: 0 1px 2px rgba(15,23,42,.06);
  --shadow: 0 1px 3px rgba(15,23,42,.08), 0 1px 2px rgba(15,23,42,.04);
  --shadow-lg: 0 20px 40px rgba(15,23,42,.18);
  --transition: 180ms ease;
}
[data-theme="dark"] {
  --bg: #0b1220;
  --surface: #111a2e;
  --surface-2: #1a2540;
  --text: #e6edf7;
  --muted: #94a3b8;
  --border: #26334d;
  --primary: #3b82f6;
  --income: #22c55e;
  --expense: #f87171;
  --warning: #fbbf24;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.4);
  --shadow: 0 1px 3px rgba(0,0,0,.5);
  --shadow-lg: 0 20px 40px rgba(0,0,0,.6);
}

body {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg); color: var(--text);
  font-size: 15px; line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ============ Layout ============ */
.app { display: flex; min-height: 100vh; }

.sidebar {
  width: 240px; flex-shrink: 0;
  background: var(--surface); border-right: 1px solid var(--border);
  padding: 20px 14px;
  display: flex; flex-direction: column; gap: 18px;
  position: sticky; top: 0; height: 100vh;
}
.brand { display: flex; gap: 10px; align-items: center; padding: 4px 6px; }
.brand-logo { font-size: 26px; }
.brand-name { font-weight: 700; font-size: 17px; }
.brand-sub { font-size: 12px; color: var(--muted); }

.nav { display: flex; flex-direction: column; gap: 4px; }
.nav-item {
  display: flex; gap: 10px; align-items: center;
  padding: 10px 12px; border-radius: var(--radius-sm);
  color: var(--text); text-decoration: none; font-weight: 500;
  transition: background var(--transition), color var(--transition);
}
.nav-item:hover { background: var(--surface-2); }
.nav-item.active { background: var(--primary); color: var(--primary-fg); }
.nav-icon { font-size: 17px; }

.sidebar-footer { margin-top: auto; }

.main {
  flex: 1; min-width: 0;
  padding: 24px clamp(16px, 3vw, 32px) 40px;
  max-width: 1240px; width: 100%; margin: 0 auto;
}
.main:focus { outline: none; }

.bottomnav { display: none; }

@media (max-width: 860px) {
  .sidebar { display: none; }
  .main { padding-bottom: 96px; }
  .bottomnav {
    display: flex; position: fixed; bottom: 0; left: 0; right: 0;
    background: var(--surface); border-top: 1px solid var(--border);
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
    z-index: 40; overflow-x: auto;
  }
  .bottomnav .nav-item {
    flex: 0 0 auto; min-width: 62px;
    flex-direction: column; gap: 2px; padding: 6px 4px;
    font-size: 10.5px; text-align: center;
  }
  .bottomnav .nav-icon { font-size: 18px; }
}

/* ============ Headers y grillas ============ */
.page-head {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 16px; margin-bottom: 20px; flex-wrap: wrap;
}
.page-head h1 { margin: 0; font-size: clamp(22px, 3vw, 28px); letter-spacing: -.01em; }
.page-head p { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
.actions { display: flex; gap: 8px; flex-wrap: wrap; }

.grid { display: grid; gap: 16px; margin-bottom: 18px; }
.stats-grid { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
.two-col { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }

/* ============ Cards ============ */
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px;
  box-shadow: var(--shadow-sm); margin-bottom: 18px;
}
.card-head {
  display: flex; justify-content: space-between; align-items: center;
  gap: 10px; margin-bottom: 14px;
}
.card-head h3 { margin: 0; font-size: 15px; font-weight: 600; }

.stat-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px;
  box-shadow: var(--shadow-sm);
}
.stat-label { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
.stat-value {
  font-size: clamp(20px, 2.6vw, 26px); font-weight: 700;
  letter-spacing: -.01em; font-variant-numeric: tabular-nums;
}

/* ============ Botones ============ */
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 9px 14px; border-radius: var(--radius-sm);
  border: 1px solid transparent; background: var(--surface-2); color: var(--text);
  font: inherit; font-weight: 600; font-size: 14px; cursor: pointer;
  transition: transform var(--transition), background var(--transition),
              border-color var(--transition), opacity var(--transition), filter var(--transition);
}
.btn:hover { filter: brightness(.97); }
.btn:active { transform: scale(.98); }
.btn-primary { background: var(--primary); color: var(--primary-fg); }
.btn-income { background: var(--income); color: #fff; }
.btn-expense { background: var(--expense); color: #fff; }
.btn-danger { background: var(--danger); color: #fff; }
.btn-ghost { background: transparent; border-color: var(--border); }
.btn-ghost:hover { background: var(--surface-2); }

.icon-btn {
  background: transparent; border: 0; padding: 6px; border-radius: 8px;
  cursor: pointer; font-size: 15px; color: var(--muted); line-height: 1;
}
.icon-btn:hover { background: var(--surface-2); color: var(--text); }

.link {
  color: var(--primary); text-decoration: none; font-weight: 600;
  font-size: 13px; background: none; border: 0; cursor: pointer;
  padding: 0; font-family: inherit;
}
.link:hover { text-decoration: underline; }
.actions-row { display: flex; flex-wrap: wrap; gap: 8px; }

/* ============ Formularios ============ */
.field { display: flex; flex-direction: column; gap: 5px; }
.field label { font-size: 12.5px; font-weight: 600; color: var(--muted); }
.field input, .field select, .field textarea {
  width: 100%; padding: 10px 12px;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  background: var(--surface); color: var(--text);
  font: inherit; font-size: 14px;
  transition: border-color var(--transition), box-shadow var(--transition);
}
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none; border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37,99,235,.18);
}
.field .err { color: var(--danger); font-size: 12px; min-height: 14px; }

.input-prefix {
  display: flex; align-items: stretch;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  overflow: hidden; background: var(--surface);
}
.input-prefix span {
  padding: 0 10px; display: flex; align-items: center;
  background: var(--surface-2); font-size: 12px; color: var(--muted);
  border-right: 1px solid var(--border);
}
.input-prefix input { border: 0; border-radius: 0; }
.input-prefix:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(37,99,235,.18);
}

.checkbox { display: flex; gap: 8px; align-items: center; font-size: 14px; cursor: pointer; }
.form { display: flex; flex-direction: column; gap: 12px; }
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.filter-row {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px; margin-bottom: 12px;
}
.filter-actions { display: flex; justify-content: flex-end; }

/* ============ Tablas ============ */
.table-wrap { overflow-x: auto; margin: -6px; }
.table { width: 100%; border-collapse: collapse; font-size: 14px; }
.table th, .table td {
  padding: 10px 12px; text-align: left;
  border-bottom: 1px solid var(--border); white-space: nowrap;
}
.table th {
  font-size: 11.5px; font-weight: 600; color: var(--muted);
  text-transform: uppercase; letter-spacing: .04em;
}
.table tr:last-child td { border-bottom: 0; }
.table tfoot th { border-top: 2px solid var(--border); border-bottom: 0; }
.table .num { text-align: right; font-variant-numeric: tabular-nums; }
.row-actions { text-align: right; white-space: nowrap; }

/* ============ Utilidades ============ */
.pos { color: var(--income); }
.neg { color: var(--expense); }
.muted { color: var(--muted); }
.small { font-size: 12.5px; }
.center { text-align: center; }

.chip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 9px; border-radius: 999px;
  font-size: 12.5px; font-weight: 600;
}

.delta { font-size: 12.5px; font-weight: 600; }
.delta.up { color: var(--income); }
.delta.down { color: var(--expense); }

/* ============ Progreso ============ */
.progress {
  height: 8px; background: var(--surface-2); border-radius: 999px;
  overflow: hidden; margin: 8px 0 4px;
}
.progress-bar {
  height: 100%; background: var(--primary); border-radius: 999px;
  transition: width 400ms ease;
}
.progress-bar.warn { background: var(--warning); }
.progress-bar.danger { background: var(--danger); }

.budget-number { font-size: 26px; font-weight: 700; margin: 4px 0; }
.budget-number.warn { color: var(--warning); }
.budget-number.danger { color: var(--danger); }
.budget-row { padding: 12px 0; border-bottom: 1px solid var(--border); }
.budget-row:last-child { border-bottom: 0; }
.budget-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
.budget-actions { margin-top: 4px; }

/* ============ Gráficos ============ */
.chart-wrap { position: relative; height: 240px; }
.chart { width: 100%; height: 100%; display: block; }
.legend {
  display: flex; flex-wrap: wrap; gap: 8px 16px;
  margin-top: 12px; font-size: 13px;
}
.legend-item { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); }
.legend-item b { color: var(--text); }
.dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

/* ============ Lista transacciones ============ */
.tx-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.tx-row {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 0; border-bottom: 1px solid var(--border);
}
.tx-row:last-child { border-bottom: 0; }
.tx-icon {
  width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
  border-radius: 10px; font-size: 18px; flex-shrink: 0;
}
.tx-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.tx-desc { font-weight: 600; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tx-meta { font-size: 12px; color: var(--muted); }
.tx-amount { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }

/* ============ Categorías ============ */
.cat-list { list-style: none; margin: 0; padding: 0; }
.cat-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 0; border-bottom: 1px solid var(--border);
}
.cat-item:last-child { border-bottom: 0; }
.cat-icon {
  width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
  border-radius: 10px; font-size: 18px; flex-shrink: 0;
}
.cat-info { flex: 1; min-width: 0; }
.cat-name { font-weight: 600; font-size: 14px; }
.cat-actions { display: flex; gap: 4px; }

/* ============ Top list ============ */
.top-list { list-style: none; margin: 0; padding: 0; }
.top-list li {
  display: flex; align-items: center; gap: 12px;
  padding: 8px 0; border-bottom: 1px solid var(--border);
}
.top-list li:last-child { border-bottom: 0; }
.top-list .rank {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--surface-2); display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700;
}
.top-amount { margin-left: auto; font-weight: 700; }

/* ============ Atajos ============ */
.shortcuts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
kbd {
  background: var(--surface-2); border: 1px solid var(--border); border-bottom-width: 2px;
  border-radius: 6px; padding: 2px 7px; font-size: 12px; font-family: inherit; font-weight: 600;
}

/* ============ Empty state ============ */
.empty-state { text-align: center; padding: 40px 16px; }
.empty-icon { font-size: 42px; margin-bottom: 8px; }
.empty-state h3 { margin: 0 0 6px; font-size: 16px; }
.empty-state p { margin: 0 0 14px; color: var(--muted); font-size: 14px; }

/* ============ Toasts ============ */
.toast-container {
  position: fixed; bottom: 96px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; gap: 8px; z-index: 100;
  pointer-events: none;
}
@media (min-width: 861px) {
  .toast-container { bottom: 24px; left: auto; right: 24px; transform: none; }
}
.toast {
  display: flex; gap: 8px; align-items: center;
  padding: 10px 14px; border-radius: var(--radius-sm);
  background: var(--surface); border: 1px solid var(--border);
  box-shadow: var(--shadow-lg); font-size: 14px;
  opacity: 0; transform: translateY(10px);
  transition: opacity 200ms ease, transform 200ms ease;
  max-width: 92vw;
}
.toast.show { opacity: 1; transform: translateY(0); }
.toast-success { border-left: 3px solid var(--income); }
.toast-error   { border-left: 3px solid var(--expense); }
.toast-info    { border-left: 3px solid var(--primary); }

/* ============ Modales ============ */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(15,23,42,.45);
  display: flex; align-items: center; justify-content: center;
  padding: 16px; z-index: 200; opacity: 0;
  transition: opacity 200ms ease;
}
.modal-overlay.show { opacity: 1; }
.modal {
  background: var(--surface); border-radius: var(--radius);
  box-shadow: var(--shadow-lg); width: 100%; max-width: 520px;
  max-height: calc(100vh - 32px); display: flex; flex-direction: column;
  transform: translateY(10px) scale(.98); transition: transform 200ms ease;
}
.modal-overlay.show .modal { transform: none; }
.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 20px; border-bottom: 1px solid var(--border);
}
.modal-header h2 { margin: 0; font-size: 17px; }
.modal-body { padding: 18px 20px; overflow-y: auto; }
.modal-footer { padding: 14px 20px; border-top: 1px solid var(--border); }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
.modal-message { margin: 0; color: var(--text); }

/* ============ Impresión ============ */
@media print {
  .sidebar, .bottomnav, .page-head .actions,
  .toast-container, .modal-overlay, .filters,
  .filter-row, .filter-actions { display: none !important; }
  .main { padding: 0; max-width: none; }
  .card { box-shadow: none; border: 1px solid #ddd; page-break-inside: avoid; }
  body { background: #fff; }
}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-logo">💰</div>
      <div>
        <div class="brand-name">FinTrack</div>
        <div class="brand-sub">Finanzas personales</div>
      </div>
    </div>
    <nav class="nav" id="desktop-nav" aria-label="Navegación principal"></nav>
    <div class="sidebar-footer">
      <button class="btn btn-ghost" id="theme-toggle" title="Cambiar tema">🌙 Tema</button>
    </div>
  </aside>

  <main class="main" id="main" tabindex="-1"></main>

  <nav class="bottomnav" id="bottom-nav" aria-label="Navegación inferior"></nav>
</div>

<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="false"></div>
<div id="modal-root"></div>

<script>
/* =========================================================
   FinTrack — Script único autocontenido
   Orden: utils → store → charts → ui → forms → views → app
   ========================================================= */
(function () {
'use strict';

/* ============ 1) UTILS ============ */
const Utils = (function () {
  const pad = n => String(n).padStart(2, '0');
  function uuid() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }
  const todayISO = () => {
    const d = new Date();
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  };
  const parseISO = iso => {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const isoFromDate = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  function formatDate(iso, fmt) {
    if (!iso) return '';
    const [y, m, d] = iso.split('-');
    const map = { YYYY: y, MM: m, DD: d, M: String(+m), D: String(+d) };
    return (fmt || 'DD/MM/YYYY').replace(/YYYY|MM|DD|M|D/g, k => map[k]);
  }
  const formatDateLong = iso =>
    parseISO(iso).toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
  function formatMoney(n, currency) {
    n = Number(n) || 0;
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency', currency,
        maximumFractionDigits: 2, minimumFractionDigits: 2
      }).format(n);
    } catch (e) { return `${currency} ${n.toFixed(2)}`; }
  }
  const monthKey = iso => iso.slice(0, 7);
  function monthLabel(key) {
    const [y, m] = key.split('-');
    return new Date(+y, +m - 1, 1)
      .toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
  }
  function currentMonthKey() {
    const d = new Date();
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
  }
  function addMonths(key, delta) {
    const [y, m] = key.split('-').map(Number);
    const d = new Date(y, m - 1 + delta, 1);
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
  }
  function startOfWeekISO() {
    const d = new Date();
    const day = (d.getDay() + 6) % 7;
    d.setDate(d.getDate() - day);
    return isoFromDate(d);
  }
  function percentChange(current, previous) {
    if (previous === 0) return current === 0 ? 0 : (current > 0 ? 100 : -100);
    return ((current - previous) / Math.abs(previous)) * 100;
  }
  const escapeHtml = s =>
    String(s == null ? '' : s).replace(/[&<>"']/g,
      c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  function debounce(fn, ms) {
    let t;
    return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
  }
  function download(filename, content, mime) {
    const blob = new Blob([content], { type: mime || 'application/octet-stream' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 800);
  }
  return {
    pad, uuid, todayISO, parseISO, isoFromDate, formatDate, formatDateLong,
    formatMoney, monthKey, monthLabel, currentMonthKey, addMonths,
    startOfWeekISO, percentChange, escapeHtml, debounce, download
  };
})();

/* ============ 2) STORE ============ */
const Store = (function () {
  const KEY = 'fintrack_v1';
  const DEFAULT_CATEGORIES = [
    { name: 'Vivienda',            icon: '🏠', color: '#3b82f6', type: 'expense' },
    { name: 'Alimentación',        icon: '🍽️', color: '#ef4444', type: 'expense' },
    { name: 'Transporte',          icon: '🚗', color: '#f59e0b', type: 'expense' },
    { name: 'Servicios',           icon: '💡', color: '#eab308', type: 'expense' },
    { name: 'Salud',               icon: '🏥', color: '#10b981', type: 'expense' },
    { name: 'Educación',           icon: '📚', color: '#6366f1', type: 'expense' },
    { name: 'Entretenimiento',     icon: '🎬', color: '#ec4899', type: 'expense' },
    { name: 'Ropa y calzado',      icon: '👕', color: '#14b8a6', type: 'expense' },
    { name: 'Deudas y préstamos',  icon: '💳', color: '#f43f5e', type: 'expense' },
    { name: 'Ahorro e inversión',  icon: '🏦', color: '#22c55e', type: 'expense' },
    { name: 'Seguros',             icon: '🛡️', color: '#0ea5e9', type: 'expense' },
    { name: 'Cuidado personal',    icon: '💅', color: '#d946ef', type: 'expense' },
    { name: 'Mascotas',            icon: '🐾', color: '#a855f7', type: 'expense' },
    { name: 'Regalos y donaciones',icon: '🎁', color: '#fb7185', type: 'expense' },
    { name: 'Imprevistos',         icon: '⚠️', color: '#f97316', type: 'expense' },
    { name: 'Impuestos',           icon: '📋', color: '#64748b', type: 'expense' },
    { name: 'Familia e hijos',     icon: '👨‍👩‍👧', color: '#8b5cf6', type: 'expense' },
    { name: 'Salario',             icon: '💼', color: '#22c55e', type: 'income' },
    { name: 'Freelance',           icon: '💻', color: '#10b981', type: 'income' },
    { name: 'Inversiones',         icon: '📈', color: '#0ea5e9', type: 'income' },
    { name: 'Regalos',             icon: '🎁', color: '#ec4899', type: 'income' },
    { name: 'Ventas',              icon: '💵', color: '#14b8a6', type: 'income' },
    { name: 'Reembolsos',          icon: '🔁', color: '#6366f1', type: 'income' },
    { name: 'Otros ingresos',      icon: '❓', color: '#64748b', type: 'income' }
  ];

  let state = null;
  const listeners = new Set();

  function defaultState() {
    return {
      version: 1,
      settings: {
        userName: '', currency: 'USD', dateFormat: 'DD/MM/YYYY',
        theme: 'light', globalBudget: null
      },
      categories: DEFAULT_CATEGORIES.map((c, i) => ({
        id: Utils.uuid(), name: c.name, icon: c.icon, color: c.color,
        type: c.type, budget: null, createdAt: Date.now() + i
      })),
      transactions: [],
      meta: { createdAt: Date.now(), lastRecurringRun: null }
    };
  }
  function normalizeTx(t) {
    return {
      id: t.id || Utils.uuid(),
      type: t.type === 'income' ? 'income' : 'expense',
      amount: Number(t.amount) || 0,
      categoryId: t.categoryId || null,
      subcategory: t.subcategory || '',
      description: t.description || '',
      date: /^\d{4}-\d{2}-\d{2}$/.test(t.date) ? t.date : Utils.todayISO(),
      paymentMethod: t.paymentMethod || '',
      recurring: !!t.recurring,
      notes: t.notes || '',
      tags: Array.isArray(t.tags) ? t.tags : [],
      sourceId: t.sourceId || null,
      createdAt: t.createdAt || Date.now()
    };
  }
  function normalize(obj) {
    const base = defaultState();
    const s = obj && typeof obj === 'object' ? obj : {};
    return {
      version: 1,
      settings: { ...base.settings, ...(s.settings || {}) },
      categories: Array.isArray(s.categories) && s.categories.length
        ? s.categories.map(c => ({
            id: c.id || Utils.uuid(),
            name: String(c.name || 'Sin nombre'),
            icon: c.icon || '🏷️',
            color: c.color || '#64748b',
            type: (c.type === 'income' || c.type === 'expense') ? c.type : 'both',
            budget: typeof c.budget === 'number' && c.budget > 0 ? c.budget : null,
            createdAt: c.createdAt || Date.now()
          }))
        : base.categories,
      transactions: Array.isArray(s.transactions)
        ? s.transactions.filter(t => t && typeof t === 'object').map(normalizeTx)
        : [],
      meta: { ...base.meta, ...(s.meta || {}) }
    };
  }
  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      state = raw ? normalize(JSON.parse(raw)) : defaultState();
    } catch (e) {
      console.error('FinTrack: error al cargar', e);
      state = defaultState();
    }
    persist();
  }
  function persist() {
    try { localStorage.setItem(KEY, JSON.stringify(state)); return true; }
    catch (e) {
      console.error('FinTrack: error al guardar', e);
      if (UI && UI.toast) UI.toast('No se pudo guardar (¿almacenamiento lleno?)', 'error');
      return false;
    }
  }
  function emit() { listeners.forEach(fn => { try { fn(state); } catch (e) { console.error(e); } }); }
  const commit = () => { persist(); emit(); };

  const get = () => state;
  const getSettings = () => state.settings;
  function subscribe(fn) { listeners.add(fn); return () => listeners.delete(fn); }
  const categoryById = id => state.categories.find(c => c.id === id) || null;
  const categoriesFor = type => state.categories.filter(c => c.type === type || c.type === 'both');

  function addTransaction(data) {
    const tx = normalizeTx({ ...data, id: Utils.uuid(), createdAt: Date.now() });
    state.transactions.push(tx); commit(); return tx;
  }
  function updateTransaction(id, data) {
    const idx = state.transactions.findIndex(t => t.id === id);
    if (idx < 0) return null;
    state.transactions[idx] = normalizeTx({ ...state.transactions[idx], ...data, id });
    commit(); return state.transactions[idx];
  }
  function deleteTransaction(id) {
    const before = state.transactions.length;
    state.transactions = state.transactions.filter(t => t.id !== id);
    if (state.transactions.length !== before) { commit(); return true; }
    return false;
  }
  function addCategory(data) {
    const cat = {
      id: Utils.uuid(),
      name: String(data.name || '').trim() || 'Sin nombre',
      icon: (data.icon || '🏷️').trim() || '🏷️',
      color: data.color || '#64748b',
      type: (data.type === 'income' || data.type === 'expense') ? data.type : 'both',
      budget: typeof data.budget === 'number' && data.budget > 0 ? data.budget : null,
      createdAt: Date.now()
    };
    state.categories.push(cat); commit(); return cat;
  }
  function updateCategory(id, data) {
    const cat = state.categories.find(c => c.id === id);
    if (!cat) return null;
    if (data.name !== undefined) cat.name = String(data.name).trim() || cat.name;
    if (data.icon !== undefined) cat.icon = data.icon || cat.icon;
    if (data.color !== undefined) cat.color = data.color || cat.color;
    if (data.type !== undefined) cat.type = data.type;
    if (data.budget !== undefined)
      cat.budget = typeof data.budget === 'number' && data.budget > 0 ? data.budget : null;
    commit(); return cat;
  }
  function deleteCategory(id) {
    if (state.transactions.some(t => t.categoryId === id)) return { ok: false, reason: 'in-use' };
    state.categories = state.categories.filter(c => c.id !== id);
    commit(); return { ok: true };
  }
  function updateSettings(patch) { state.settings = { ...state.settings, ...patch }; commit(); }

  const transactionsInMonth = mk => state.transactions.filter(t => t.date.slice(0, 7) === mk);
  const sumByType = (list, type) => list.filter(t => t.type === type).reduce((s, t) => s + t.amount, 0);
  function monthTotals(mk) {
    const list = transactionsInMonth(mk);
    const income = sumByType(list, 'income');
    const expense = sumByType(list, 'expense');
    return { income, expense, balance: income - expense, count: list.length };
  }
  function expenseByCategory(mk) {
    const map = new Map();
    transactionsInMonth(mk).filter(t => t.type === 'expense').forEach(t => {
      map.set(t.categoryId, (map.get(t.categoryId) || 0) + t.amount);
    });
    return [...map.entries()].map(([categoryId, total]) => ({ categoryId, total }))
      .sort((a, b) => b.total - a.total);
  }
  const exportJSON = () => JSON.stringify(state, null, 2);
  function exportCSV() {
    const catMap = new Map(state.categories.map(c => [c.id, c]));
    const rows = [['id','tipo','fecha','monto','categoria','subcategoria','descripcion','metodo_pago','recurrente','notas','tags']];
    state.transactions.slice().sort((a, b) => a.date.localeCompare(b.date)).forEach(t => {
      const c = catMap.get(t.categoryId);
      rows.push([
        t.id, t.type === 'income' ? 'ingreso' : 'gasto', t.date, t.amount,
        c ? c.name : '', t.subcategory || '', t.description || '',
        t.paymentMethod || '', t.recurring ? 'sí' : 'no',
        t.notes || '', (t.tags || []).join('|')
      ]);
    });
    return rows.map(r => r.map(v => {
      const s = String(v == null ? '' : v);
      return /[",\n;]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }).join(',')).join('\n');
  }
  function importJSON(obj) {
    if (!obj || typeof obj !== 'object') throw new Error('Formato inválido');
    if (!Array.isArray(obj.transactions) || !Array.isArray(obj.categories))
      throw new Error('Faltan campos requeridos (transactions, categories)');
    state = normalize(obj); commit(); return true;
  }
  function seedSample() {
    const find = (name, type) => state.categories.find(c => c.name === name && (c.type === type || c.type === 'both'));
    const salary = find('Salario', 'income');
    const freelance = find('Freelance', 'income');
    const food = find('Alimentación', 'expense');
    const housing = find('Vivienda', 'expense');
    const transport = find('Transporte', 'expense');
    const services = find('Servicios', 'expense');
    const fun = find('Entretenimiento', 'expense');
    const now = new Date();
    for (let i = 0; i < 3; i++) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const mk = `${d.getFullYear()}-${Utils.pad(d.getMonth() + 1)}`;
      const add = (t) => state.transactions.push(normalizeTx(t));
      add({ type: 'income',  amount: 2500 + Math.round(Math.random() * 300), categoryId: salary.id,    description: 'Salario mensual',  date: `${mk}-01` });
      add({ type: 'income',  amount: 400 + Math.round(Math.random() * 400),  categoryId: freelance.id, description: 'Proyecto freelance', date: `${mk}-15` });
      add({ type: 'expense', amount: 900,                                    categoryId: housing.id,   description: 'Renta',              date: `${mk}-05` });
      add({ type: 'expense', amount: 350 + Math.round(Math.random() * 150),  categoryId: food.id,      description: 'Supermercado',       date: `${mk}-07`, paymentMethod: 'tarjeta débito' });
      add({ type: 'expense', amount: 120 + Math.round(Math.random() * 80),   categoryId: food.id,      description: 'Restaurantes',       date: `${mk}-12`, paymentMethod: 'tarjeta crédito' });
      add({ type: 'expense', amount: 180,                                    categoryId: transport.id, description: 'Gasolina',           date: `${mk}-09`, paymentMethod: 'efectivo' });
      add({ type: 'expense', amount: 210,                                    categoryId: services.id,  description: 'Luz, agua e internet', date: `${mk}-10`, paymentMethod: 'transferencia' });
      add({ type: 'expense', amount: 90 + Math.round(Math.random() * 60),    categoryId: fun.id,       description: 'Cine y salidas',     date: `${mk}-20`, paymentMethod: 'tarjeta crédito' });
    }
    if (food)      food.budget = 400;
    if (transport) transport.budget = 250;
    if (fun)       fun.budget = 150;
    state.settings.globalBudget = 2000;
    commit();
  }
  function processRecurring() {
    const current = Utils.currentMonthKey();
    if (state.meta.lastRecurringRun === current) return 0;
    let created = 0;
    state.transactions.filter(t => t.recurring).forEach(t => {
      if (t.date.slice(0, 7) >= current) return;
      if (state.transactions.some(x => x.sourceId === t.id && x.date.slice(0, 7) === current)) return;
      const day = Math.min(Number(t.date.slice(8, 10)), 28);
      state.transactions.push({
        ...t, id: Utils.uuid(),
        date: `${current}-${Utils.pad(day)}`,
        sourceId: t.id, createdAt: Date.now()
      });
      created++;
    });
    state.meta.lastRecurringRun = current;
    persist(); return created;
  }
  function clearAll() { state = defaultState(); commit(); }

  return {
    init() { load(); },
    get, getSettings, subscribe,
    categoryById, categoriesFor,
    addTransaction, updateTransaction, deleteTransaction,
    addCategory, updateCategory, deleteCategory,
    updateSettings,
    transactionsInMonth, monthTotals, expenseByCategory,
    exportJSON, exportCSV, importJSON,
    seedSample, processRecurring, clearAll,
    DEFAULT_CATEGORIES
  };
})();

/* ============ 3) CHARTS ============ */
const Charts = (function () {
  function setup(canvas) {
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    const w = Math.max(rect.width, 10);
    const h = Math.max(rect.height, 10);
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    return { ctx, w, h };
  }
  const themeColor = name =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || '#000';

  function donut(canvas, data, centerLabel) {
    const { ctx, w, h } = setup(canvas);
    const total = data.reduce((s, d) => s + d.value, 0);
    if (total <= 0) {
      ctx.fillStyle = themeColor('--muted');
      ctx.font = '14px system-ui, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Sin datos', w / 2, h / 2);
      return;
    }
    const cx = w / 2, cy = h / 2;
    const outer = Math.min(w, h) / 2 - 6;
    const inner = outer * 0.62;
    let start = -Math.PI / 2;
    data.forEach(d => {
      const angle = (d.value / total) * Math.PI * 2;
      if (angle <= 0) return;
      ctx.beginPath();
      ctx.arc(cx, cy, outer, start, start + angle);
      ctx.arc(cx, cy, inner, start + angle, start, true);
      ctx.closePath();
      ctx.fillStyle = d.color; ctx.fill();
      start += angle;
    });
    ctx.fillStyle = themeColor('--muted');
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.font = '600 12px system-ui, sans-serif';
    ctx.fillText(centerLabel ? centerLabel[0] : 'Total', cx, cy - 11);
    ctx.fillStyle = themeColor('--text');
    ctx.font = '700 15px system-ui, sans-serif';
    ctx.fillText(centerLabel ? centerLabel[1] : String(total), cx, cy + 10);
  }
  function bars(canvas, data) {
    const { ctx, w, h } = setup(canvas);
    const padL = 8, padR = 8, padT = 12, padB = 28;
    const chartW = w - padL - padR;
    const chartH = h - padT - padB;
    const max = Math.max(1, ...data.map(d => Math.max(d.income, d.expense)));
    const groupW = chartW / data.length;
    const barW = Math.max(4, Math.min(18, groupW * 0.32));
    const gap = 4;
    const incomeColor = themeColor('--income');
    const expenseColor = themeColor('--expense');
    const mutedColor = themeColor('--muted');
    const border = themeColor('--border');
    ctx.strokeStyle = border; ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padT + (chartH * i) / 4;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
    }
    data.forEach((d, i) => {
      const cx = padL + groupW * i + groupW / 2;
      const ih = (d.income / max) * chartH;
      const eh = (d.expense / max) * chartH;
      ctx.fillStyle = incomeColor;
      ctx.fillRect(cx - barW - gap / 2, padT + chartH - ih, barW, ih);
      ctx.fillStyle = expenseColor;
      ctx.fillRect(cx + gap / 2, padT + chartH - eh, barW, eh);
      ctx.fillStyle = mutedColor;
      ctx.font = '11px system-ui, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(d.label, cx, padT + chartH + 6);
    });
  }
  return { donut, bars };
})();

/* ============ 4) UI (toast/modal/confirm/emptyState) ============ */
const UI = (function () {
  function toast(message, type = 'info', timeout = 3200) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const el = document.createElement('div');
    el.className = `toast toast-${type}`;
    el.setAttribute('role', 'status');
    const icon = type === 'error' ? '⚠️' : type === 'success' ? '✅' : 'ℹ️';
    el.innerHTML = `<span>${icon}</span><span>${Utils.escapeHtml(message)}</span>`;
    container.appendChild(el);
    requestAnimationFrame(() => el.classList.add('show'));
    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => el.remove(), 250);
    }, timeout);
  }
  function modal({ title, body, footer, onMount }) {
    const root = document.getElementById('modal-root');
    const overlay = document.createElement('div');
    overlay.className = 'modal-overlay';
    overlay.innerHTML = `
      <div class="modal" role="dialog" aria-modal="true" aria-label="${Utils.escapeHtml(title || '')}">
        <div class="modal-header">
          <h2>${Utils.escapeHtml(title || '')}</h2>
          <button class="icon-btn modal-close" aria-label="Cerrar">✕</button>
        </div>
        <div class="modal-body"></div>
        ${footer ? '<div class="modal-footer"></div>' : ''}
      </div>`;
    const bodyEl = overlay.querySelector('.modal-body');
    if (typeof body === 'string') bodyEl.innerHTML = body;
    else if (body) bodyEl.appendChild(body);
    if (footer) {
      const f = overlay.querySelector('.modal-footer');
      if (typeof footer === 'string') f.innerHTML = footer;
      else f.appendChild(footer);
    }
    function onKey(e) { if (e.key === 'Escape') close(); }
    function close() {
      document.removeEventListener('keydown', onKey);
      overlay.classList.remove('show');
      setTimeout(() => overlay.remove(), 200);
    }
    overlay.querySelector('.modal-close').addEventListener('click', close);
    overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', onKey);
    root.appendChild(overlay);
    requestAnimationFrame(() => overlay.classList.add('show'));
    if (onMount) onMount({ overlay, body: bodyEl, close });
    return { close, overlay };
  }
  function confirm({
    title = 'Confirmar', message = '',
    confirmText = 'Aceptar', cancelText = 'Cancelar', danger = false
  }) {
    return new Promise(resolve => {
      const footer = document.createElement('div');
      footer.className = 'modal-actions';
      footer.innerHTML = `
        <button type="button" class="btn btn-ghost" data-act="cancel">${Utils.escapeHtml(cancelText)}</button>
        <button type="button" class="btn ${danger ? 'btn-danger' : 'btn-primary'}" data-act="ok">${Utils.escapeHtml(confirmText)}</button>`;
      const m = modal({
        title,
        body: `<p class="modal-message">${Utils.escapeHtml(message)}</p>`,
        footer
      });
      footer.querySelector('[data-act="cancel"]').addEventListener('click', () => { m.close(); resolve(false); });
      footer.querySelector('[data-act="ok"]').addEventListener('click', () => { m.close(); resolve(true); });
      m.overlay.addEventListener('click', e => { if (e.target === m.overlay) resolve(false); });
    });
  }
  function emptyState({ icon = '📭', title, text, action }) {
    return `<div class="empty-state">
      <div class="empty-icon">${icon}</div>
      <h3>${Utils.escapeHtml(title)}</h3>
      <p>${Utils.escapeHtml(text)}</p>
      ${action || ''}
    </div>`;
  }
  return { toast, modal, confirm, emptyState };
})();

/* ============ 5) FORMS ============ */
const Forms = (function () {
  const PAYMENT_METHODS = ['efectivo', 'tarjeta débito', 'tarjeta crédito', 'transferencia', 'otro'];

  function transactionForm({ type, transaction, onSaved }) {
    const isEdit = !!transaction;
    const t = transaction || {};
    const cats = Store.categoriesFor(type);
    const currency = Store.getSettings().currency;
    const form = document.createElement('form');
    form.className = 'form';
    form.noValidate = true;
    form.innerHTML = `
      <div class="field">
        <label for="tx-amount">Monto *</label>
        <div class="input-prefix">
          <span>${Utils.escapeHtml(currency)}</span>
          <input id="tx-amount" name="amount" type="number" inputmode="decimal"
                 step="0.01" min="0.01" required
                 value="${t.amount ?? ''}" placeholder="0.00">
        </div>
        <small class="err" data-err="amount"></small>
      </div>
      <div class="field">
        <label for="tx-date">Fecha *</label>
        <input id="tx-date" name="date" type="date" required value="${t.date || Utils.todayISO()}">
