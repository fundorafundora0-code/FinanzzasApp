      </div>
      <div class="field">
        <label for="tx-category">Categoría *</label>
        <select id="tx-category" name="categoryId" required>
          <option value="">Selecciona una categoría</option>
          ${cats.map(c => `<option value="${c.id}" ${t.categoryId === c.id ? 'selected' : ''}>${c.icon} ${Utils.escapeHtml(c.name)}</option>`).join('')}
        </select>
        <small class="err" data-err="categoryId"></small>
      </div>
      ${type === 'expense' ? `
      <div class="field">
        <label for="tx-sub">Subcategoría</label>
        <input id="tx-sub" name="subcategory" type="text"
               value="${Utils.escapeHtml(t.subcategory || '')}" placeholder="Ej. Supermercado">
      </div>
      <div class="field">
        <label for="tx-pay">Método de pago</label>
        <select id="tx-pay" name="paymentMethod">
          <option value="">—</option>
          ${PAYMENT_METHODS.map(m => `<option value="${m}" ${t.paymentMethod === m ? 'selected' : ''}>${m}</option>`).join('')}
        </select>
      </div>` : ''}
      <div class="field">
        <label for="tx-desc">Descripción</label>
        <input id="tx-desc" name="description" type="text"
               value="${Utils.escapeHtml(t.description || '')}" placeholder="Ej. Compra semanal">
      </div>
      <div class="field">
        <label for="tx-notes">Notas</label>
        <textarea id="tx-notes" name="notes" rows="2" placeholder="Opcional">${Utils.escapeHtml(t.notes || '')}</textarea>
      </div>
      <div class="field">
        <label for="tx-tags">Etiquetas</label>
        <input id="tx-tags" name="tags" type="text"
               value="${(t.tags || []).join(', ')}" placeholder="Ej. verano, urgente">
      </div>
      <label class="checkbox">
        <input type="checkbox" name="recurring" ${t.recurring ? 'checked' : ''}>
        <span>Transacción recurrente (mensual)</span>
      </label>
    `;
    const footer = document.createElement('div');
    footer.className = 'modal-actions';
    footer.innerHTML = `
      <button type="button" class="btn btn-ghost" data-act="cancel">Cancelar</button>
      <button type="button" class="btn btn-primary" data-act="save">
        ${isEdit ? 'Guardar cambios' : (type === 'income' ? 'Añadir ingreso' : 'Añadir gasto')}
      </button>`;
    const title = isEdit
      ? (type === 'income' ? 'Editar ingreso' : 'Editar gasto')
      : (type === 'income' ? 'Nuevo ingreso' : 'Nuevo gasto');
    const m = UI.modal({ title, body: form, footer });
    footer.querySelector('[data-act="cancel"]').addEventListener('click', () => m.close());
    footer.querySelector('[data-act="save"]').addEventListener('click', () => form.requestSubmit());
    setTimeout(() => { const el = form.querySelector('#tx-amount'); if (el) el.focus(); }, 60);
    form.addEventListener('submit', e => {
      e.preventDefault();
      form.querySelectorAll('.err').forEach(el => el.textContent = '');
      const fd = new FormData(form);
      const amount = parseFloat(fd.get('amount'));
      const date = (fd.get('date') || '').toString();
      const categoryId = (fd.get('categoryId') || '').toString();
      let ok = true;
      if (!(amount > 0)) { form.querySelector('[data-err="amount"]').textContent = 'El monto debe ser mayor a 0'; ok = false; }
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { form.querySelector('[data-err="date"]').textContent = 'Fecha inválida'; ok = false; }
      if (!categoryId) { form.querySelector('[data-err="categoryId"]').textContent = 'Selecciona una categoría'; ok = false; }
      if (!ok) return;
      const data = {
        type, amount, date, categoryId,
        subcategory: (fd.get('subcategory') || '').toString().trim(),
        paymentMethod: (fd.get('paymentMethod') || '').toString(),
        description: (fd.get('description') || '').toString().trim(),
        notes: (fd.get('notes') || '').toString().trim(),
        tags: (fd.get('tags') || '').toString().split(',').map(s => s.trim()).filter(Boolean),
        recurring: fd.get('recurring') === 'on'
      };
      try {
        if (isEdit) Store.updateTransaction(t.id, data);
        else        Store.addTransaction(data);
        UI.toast(isEdit ? 'Actualizado correctamente'
                        : (type === 'income' ? 'Ingreso añadido' : 'Gasto añadido'), 'success');
        m.close();
        if (onSaved) onSaved();
      } catch (err) {
        console.error(err);
        UI.toast('No se pudo guardar la transacción', 'error');
      }
    });
  }
  function categoryForm({ category, onSaved } = {}) {
    const isEdit = !!category;
    const c = category || { type: 'expense', icon: '🏷️', color: '#64748b' };
    const form = document.createElement('form');
    form.className = 'form';
    form.noValidate = true;
    form.innerHTML = `
      <div class="field">
        <label>Nombre *</label>
        <input name="name" type="text" required value="${Utils.escapeHtml(c.name || '')}" placeholder="Ej. Suscripciones">
        <small class="err" data-err="name"></small>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Icono (emoji)</label>
          <input name="icon" type="text" maxlength="4" value="${Utils.escapeHtml(c.icon || '🏷️')}">
        </div>
        <div class="field">
          <label>Color</label>
          <input name="color" type="color" value="${c.color || '#64748b'}">
        </div>
      </div>
      <div class="field">
        <label>Tipo</label>
        <select name="type">
          <option value="expense" ${c.type === 'expense' ? 'selected' : ''}>Gasto</option>
          <option value="income"  ${c.type === 'income'  ? 'selected' : ''}>Ingreso</option>
          <option value="both"    ${c.type === 'both'    ? 'selected' : ''}>Ambos</option>
        </select>
      </div>
      <div class="field">
        <label>Presupuesto mensual (opcional)</label>
        <input name="budget" type="number" min="0" step="0.01"
               value="${c.budget ?? ''}" placeholder="Sin presupuesto">
      </div>
    `;
    const footer = document.createElement('div');
    footer.className = 'modal-actions';
    footer.innerHTML = `
      <button type="button" class="btn btn-ghost" data-act="cancel">Cancelar</button>
      <button type="button" class="btn btn-primary" data-act="save">${isEdit ? 'Guardar' : 'Crear'}</button>`;
    const m = UI.modal({ title: isEdit ? 'Editar categoría' : 'Nueva categoría', body: form, footer });
    footer.querySelector('[data-act="cancel"]').addEventListener('click', () => m.close());
    footer.querySelector('[data-act="save"]').addEventListener('click', () => form.requestSubmit());
    form.addEventListener('submit', e => {
      e.preventDefault();
      form.querySelectorAll('.err').forEach(el => el.textContent = '');
      const fd = new FormData(form);
      const data = {
        name: (fd.get('name') || '').toString().trim(),
        icon: (fd.get('icon') || '🏷️').toString().trim() || '🏷️',
        color: (fd.get('color') || '#64748b').toString(),
        type: (fd.get('type') || 'expense').toString(),
        budget: fd.get('budget') ? parseFloat(fd.get('budget')) : null
      };
      if (!data.name) {
        form.querySelector('[data-err="name"]').textContent = 'El nombre es obligatorio';
        return;
      }
      try {
        if (isEdit) Store.updateCategory(c.id, data);
        else        Store.addCategory(data);
        UI.toast(isEdit ? 'Categoría actualizada' : 'Categoría creada', 'success');
        m.close();
        if (onSaved) onSaved();
      } catch (err) {
        console.error(err);
        UI.toast('No se pudo guardar la categoría', 'error');
      }
    });
  }
  return { transactionForm, categoryForm, PAYMENT_METHODS };
})();

/* ============ 6) VIEWS ============ */
const Views = {};

/* --- Dashboard --- */
Views.dashboard = (function () {
  function deltaBadge(current, previous, goodWhenUp = true) {
    const pct = Utils.percentChange(current, previous);
    if (!isFinite(pct) || (current === 0 && previous === 0)) return '';
    const up = pct >= 0;
    const good = goodWhenUp ? up : !up;
    return `<span class="delta ${good ? 'up' : 'down'}">${up ? '↑' : '↓'} ${Math.abs(pct).toFixed(1)}%</span>`;
  }
  function statCard(label, valueHtml, sub) {
    return `<div class="stat-card">
      <div class="stat-label">${label}</div>
      <div class="stat-value">${valueHtml}</div>
      ${sub || ''}
    </div>`;
  }
  function txRow(t, catMap, currency) {
    const c = catMap.get(t.categoryId) || { name: 'Sin categoría', icon: '🏷️', color: '#94a3b8' };
    return `<li class="tx-row">
      <span class="tx-icon" style="background:${c.color}22;color:${c.color}">${c.icon}</span>
      <span class="tx-main">
        <span class="tx-desc">${Utils.escapeHtml(t.description || c.name)}</span>
        <span class="tx-meta">${Utils.formatDate(t.date, Store.getSettings().dateFormat)} · ${Utils.escapeHtml(c.name)}</span>
      </span>
      <span class="tx-amount ${t.type === 'income' ? 'pos' : 'neg'}">
        ${t.type === 'income' ? '+' : '−'}${Utils.formatMoney(t.amount, currency)}
      </span>
    </li>`;
  }
  function render(container) {
    const s = Store.getSettings();
    const currency = s.currency;
    const fmt = n => Utils.formatMoney(n, currency);
    const current = Utils.currentMonthKey();
    const prev = Utils.addMonths(current, -1);
    const tCur = Store.monthTotals(current);
    const tPrev = Store.monthTotals(prev);
    const all = Store.get().transactions;
    const totalIncome = all.filter(t => t.type === 'income').reduce((a, b) => a + b.amount, 0);
    const totalExpense = all.filter(t => t.type === 'expense').reduce((a, b) => a + b.amount, 0);
    const balanceTotal = totalIncome - totalExpense;
    const catMap = new Map(Store.get().categories.map(c => [c.id, c]));
    const donutData = Store.expenseByCategory(current).map(x => {
      const c = catMap.get(x.categoryId) || { name: 'Sin categoría', color: '#94a3b8' };
      return { label: c.name, value: x.total, color: c.color };
    });
    const months = [];
    for (let i = 5; i >= 0; i--) {
      const mk = Utils.addMonths(current, -i);
      const tt = Store.monthTotals(mk);
      months.push({ label: Utils.monthLabel(mk).split(' ')[0], income: tt.income, expense: tt.expense });
    }
    const recent = all.slice()
      .sort((a, b) => b.date.localeCompare(a.date) || (b.createdAt || 0) - (a.createdAt || 0))
      .slice(0, 5);
    const globalBudget = s.globalBudget;
    let budgetCard = '';
    if (globalBudget > 0) {
      const spent = tCur.expense;
      const pct = Math.min(100, (spent / globalBudget) * 100);
      const remaining = globalBudget - spent;
      const cls = pct >= 100 ? 'danger' : pct >= 80 ? 'warn' : '';
      budgetCard = `<div class="card">
        <div class="card-head"><h3>Presupuesto restante</h3><span class="muted">${fmt(globalBudget)} / mes</span></div>
        <div class="budget-number ${cls}">${fmt(Math.max(0, remaining))}</div>
        <div class="progress"><div class="progress-bar ${cls}" style="width:${pct}%"></div></div>
        <div class="muted small">Gastado ${fmt(spent)} (${pct.toFixed(0)}%)</div>
      </div>`;
    }
    container.innerHTML = `
      <header class="page-head">
        <div>
          <h1>${s.userName ? `Hola, ${Utils.escapeHtml(s.userName)} 👋` : 'Dashboard'}</h1>
          <p class="muted">${Utils.formatDateLong(Utils.todayISO())}</p>
        </div>
        <div class="actions">
          <button class="btn btn-income" data-action="new-income">＋ Ingreso</button>
          <button class="btn btn-expense" data-action="new-expense">＋ Gasto</button>
        </div>
      </header>
      <section class="grid stats-grid">
        ${statCard('Balance total', `<span class="${balanceTotal >= 0 ? 'pos' : 'neg'}">${fmt(balanceTotal)}</span>`)}
        ${statCard('Ingresos del mes', `<span class="pos">${fmt(tCur.income)}</span>`, deltaBadge(tCur.income, tPrev.income, true))}
        ${statCard('Gastos del mes', `<span class="neg">${fmt(tCur.expense)}</span>`, deltaBadge(tCur.expense, tPrev.expense, false))}
        ${statCard('Ahorro del mes', `<span class="${tCur.balance >= 0 ? 'pos' : 'neg'}">${fmt(tCur.balance)}</span>`, deltaBadge(tCur.balance, tPrev.balance, true))}
      </section>
      ${budgetCard}
      <section class="grid two-col">
        <div class="card">
          <div class="card-head"><h3>Gastos por categoría</h3><span class="muted">${Utils.monthLabel(current)}</span></div>
          <div class="chart-wrap"><canvas id="chart-donut" class="chart"></canvas></div>
          <div class="legend" id="legend-donut"></div>
        </div>
        <div class="card">
          <div class="card-head"><h3>Ingresos vs Gastos</h3><span class="muted">Últimos 6 meses</span></div>
          <div class="chart-wrap"><canvas id="chart-bars" class="chart"></canvas></div>
        </div>
      </section>
      <section class="card">
        <div class="card-head"><h3>Últimas transacciones</h3><a class="link" href="#expenses">Ver todas →</a></div>
        ${recent.length
          ? `<ul class="tx-list">${recent.map(t => txRow(t, catMap, currency)).join('')}</ul>`
          : UI.emptyState({ icon: '🧾', title: 'Sin transacciones aún', text: 'Añade tu primer ingreso o gasto para empezar.' })}
      </section>
    `;
    if (donutData.length) {
      Charts.donut(document.getElementById('chart-donut'), donutData, ['Total', fmt(tCur.expense)]);
      const total = donutData.reduce((a, b) => a + b.value, 0) || 1;
      document.getElementById('legend-donut').innerHTML = donutData.slice(0, 6).map(d =>
        `<span class="legend-item"><span class="dot" style="background:${d.color}"></span>
         ${Utils.escapeHtml(d.label)} <b>${((d.value / total) * 100).toFixed(0)}%</b></span>`
      ).join('');
    } else {
      Charts.donut(document.getElementById('chart-donut'), [], ['Sin gastos', '']);
    }
    Charts.bars(document.getElementById('chart-bars'), months);
    container.querySelector('[data-action="new-income"]').addEventListener('click',
      () => Forms.transactionForm({ type: 'income', onSaved: () => App.refresh() }));
    container.querySelector('[data-action="new-expense"]').addEventListener('click',
      () => Forms.transactionForm({ type: 'expense', onSaved: () => App.refresh() }));
  }
  return { render };
})();

/* --- Transactions (income/expense) --- */
Views.income = Views.expense = (function () {
  const stateMap = new Map();
  const defaultFilters = () => ({ q: '', range: 'all', category: '', min: null, max: null, from: '', to: '' });
  function getState(type) {
    if (!stateMap.has(type)) stateMap.set(type, defaultFilters());
    return stateMap.get(type);
  }
  const rangeLabel = r => ({
    all: 'Todo', today: 'Hoy', week: 'Esta semana', month: 'Este mes',
    last30: 'Últimos 30 días', year: 'Este año', custom: 'Personalizado'
  }[r] || r);
  function applyFilters(list, f) {
    let out = list.slice();
    const q = (f.q || '').trim().toLowerCase();
    if (q) out = out.filter(t =>
      (t.description || '').toLowerCase().includes(q) ||
      (t.notes || '').toLowerCase().includes(q) ||
      (t.tags || []).join(' ').toLowerCase().includes(q));
    if (f.category) out = out.filter(t => t.categoryId === f.category);
    if (f.min != null && !isNaN(f.min)) out = out.filter(t => t.amount >= f.min);
    if (f.max != null && !isNaN(f.max)) out = out.filter(t => t.amount <= f.max);
    if (f.range && f.range !== 'all') {
      const today = Utils.todayISO();
      const now = new Date();
      let from = null, to = today;
      if (f.range === 'today') from = today;
      else if (f.range === 'week') from = Utils.startOfWeekISO();
      else if (f.range === 'month') from = `${now.getFullYear()}-${Utils.pad(now.getMonth() + 1)}-01`;
      else if (f.range === 'last30') { const d = new Date(); d.setDate(d.getDate() - 29); from = Utils.isoFromDate(d); }
      else if (f.range === 'year') from = `${now.getFullYear()}-01-01`;
      else if (f.range === 'custom') { from = f.from || null; to = f.to || null; }
      if (from) out = out.filter(t => t.date >= from);
      if (to) out = out.filter(t => t.date <= to);
    }
    return out.sort((a, b) => b.date.localeCompare(a.date) || (b.createdAt || 0) - (a.createdAt || 0));
  }
  function rowHtml(t, catMap, currency, isIncome, fmtDate) {
    const c = catMap.get(t.categoryId) || { name: 'Sin categoría', icon: '🏷️', color: '#94a3b8' };
    return `<tr>
      <td>${Utils.formatDate(t.date, fmtDate)}</td>
      <td><span class="chip" style="background:${c.color}22;color:${c.color}">${c.icon} ${Utils.escapeHtml(c.name)}</span></td>
      <td>${Utils.escapeHtml(t.description || '—')}${t.tags && t.tags.length
        ? '<br><small class="muted">' + t.tags.map(x => '#' + Utils.escapeHtml(x)).join(' ') + '</small>'
        : ''}</td>
      ${!isIncome ? `<td><span class="muted">${Utils.escapeHtml(t.paymentMethod || '—')}</span></td>` : ''}
      <td class="num ${isIncome ? 'pos' : 'neg'}">${isIncome ? '+' : '−'}${Utils.formatMoney(t.amount, currency)}</td>
      <td class="row-actions">
        <button class="icon-btn" data-edit="${t.id}" title="Editar" aria-label="Editar">✏️</button>
        <button class="icon-btn" data-delete="${t.id}" title="Eliminar" aria-label="Eliminar">🗑️</button>
      </td>
    </tr>`;
  }
  function render(container, type) {
    const s = Store.getSettings();
    const currency = s.currency;
    const fmtDate = s.dateFormat;
    const isIncome = type === 'income';
    const viewState = getState(type);
    const cats = Store.get().categories;
    const catMap = new Map(cats.map(c => [c.id, c]));
    const filtered = applyFilters(Store.get().transactions.filter(t => t.type === type), viewState);
    const total = filtered.reduce((a, b) => a + b.amount, 0);
    container.innerHTML = `
      <header class="page-head">
        <div>
          <h1>${isIncome ? '💰 Ingresos' : '💸 Gastos'}</h1>
          <p class="muted">${filtered.length} ${filtered.length === 1 ? 'registro' : 'registros'} · Total ${Utils.formatMoney(total, currency)}</p>
        </div>
        <div class="actions">
          <button class="btn ${isIncome ? 'btn-income' : 'btn-expense'}" data-action="new">
            ＋ ${isIncome ? 'Nuevo ingreso' : 'Nuevo gasto'}
          </button>
        </div>
      </header>
      <section class="card filters">
        <div class="filter-row">
          <div class="field">
            <label>Buscar</label>
            <input type="search" data-filter="q" value="${Utils.escapeHtml(viewState.q)}"
                   placeholder="Descripción, notas, etiquetas...">
          </div>
          <div class="field">
            <label>Rango</label>
            <select data-filter="range">
              ${['all','today','week','month','last30','year','custom'].map(r =>
                `<option value="${r}" ${viewState.range === r ? 'selected' : ''}>${rangeLabel(r)}</option>`).join('')}
            </select>
          </div>
          <div class="field">
            <label>Categoría</label>
            <select data-filter="category">
              <option value="">Todas</option>
              ${cats.filter(c => c.type === type || c.type === 'both').map(c =>
                `<option value="${c.id}" ${viewState.category === c.id ? 'selected' : ''}>${c.icon} ${Utils.escapeHtml(c.name)}</option>`).join('')}
            </select>
          </div>
          <div class="field">
            <label>Monto mín.</label>
            <input type="number" data-filter="min" value="${viewState.min ?? ''}" min="0" step="0.01">
          </div>
          <div class="field">
            <label>Monto máx.</label>
            <input type="number" data-filter="max" value="${viewState.max ?? ''}" min="0" step="0.01">
          </div>
        </div>
        ${viewState.range === 'custom' ? `
          <div class="filter-row">
            <div class="field"><label>Desde</label><input type="date" data-filter="from" value="${viewState.from || ''}"></div>
            <div class="field"><label>Hasta</label><input type="date" data-filter="to" value="${viewState.to || ''}"></div>
          </div>` : ''}
        <div class="filter-actions">
          <button class="btn btn-ghost" data-action="clear-filters">Limpiar filtros</button>
        </div>
      </section>
      <section class="card">
        ${filtered.length ? `
          <div class="table-wrap">
            <table class="table">
              <thead><tr>
                <th>Fecha</th><th>Categoría</th><th>Descripción</th>
                ${!isIncome ? '<th>Método</th>' : ''}
                <th class="num">Monto</th><th></th>
              </tr></thead>
              <tbody>${filtered.map(t => rowHtml(t, catMap, currency, isIncome, fmtDate)).join('')}</tbody>
            </table>
          </div>` : UI.emptyState({
            icon: isIncome ? '💵' : '🧾',
            title: isIncome ? 'Aún no tienes ingresos registrados' : 'Aún no tienes gastos registrados',
            text: isIncome ? '¡Añade el primero!' : '¡Añade el primero para controlar tus finanzas!',
            action: `<button class="btn btn-primary" data-action="new">Añadir ${isIncome ? 'ingreso' : 'gasto'}</button>`
          })}
      </section>
    `;
    container.querySelectorAll('[data-action="new"]').forEach(b => b.addEventListener('click',
      () => Forms.transactionForm({ type, onSaved: () => App.refresh() })));
    container.querySelector('[data-action="clear-filters"]').addEventListener('click', () => {
      stateMap.set(type, defaultFilters());
      App.refresh();
    });
    container.querySelectorAll('[data-filter]').forEach(input => {
      const handler = Utils.debounce(() => {
        const key = input.dataset.filter;
        let val = input.value;
        if (key === 'min' || key === 'max') val = val === '' ? null : parseFloat(val);
        viewState[key] = val;
        App.refresh();
      }, 220);
      input.addEventListener('input', handler);
      input.addEventListener('change', handler);
    });
    container.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => {
      const tx = Store.get().transactions.find(t => t.id === b.dataset.edit);
      if (tx) Forms.transactionForm({ type, transaction: tx, onSaved: () => App.refresh() });
    }));
    container.querySelectorAll('[data-delete]').forEach(b => b.addEventListener('click', async () => {
      const ok = await UI.confirm({
        title: 'Eliminar registro',
        message: '¿Seguro que quieres eliminar este registro? Esta acción no se puede deshacer.',
        confirmText: 'Eliminar', danger: true
      });
      if (ok) {
        Store.deleteTransaction(b.dataset.delete);
        UI.toast('Registro eliminado', 'success');
        App.refresh();
      }
    }));
  }
  return { render: (c, type) => render(c, type) };
})();
Views.income.render  = c => Views.income.render(c, 'income');
Views.expense.render = c => Views.expense.render(c, 'expense');

/* --- Categories --- */
Views.categories = (function () {
  function render(container) {
    const cats = Store.get().categories;
    const tx = Store.get().transactions;
    const currency = Store.getSettings().currency;
    const counts = new Map();
    tx.forEach(t => counts.set(t.categoryId, (counts.get(t.categoryId) || 0) + 1));
    const groups = {
      expense: cats.filter(c => c.type === 'expense'),
      income:  cats.filter(c => c.type === 'income'),
      both:    cats.filter(c => c.type === 'both')
    };
    const groupTitle = { expense: 'Gastos', income: 'Ingresos', both: 'Ambos' };
    container.innerHTML = `
      <header class="page-head">
        <div><h1>🏷️ Categorías</h1><p class="muted">${cats.length} categorías</p></div>
        <div class="actions"><button class="btn btn-primary" data-action="new">＋ Nueva categoría</button></div>
      </header>
      ${['expense', 'income', 'both'].map(g => groups[g].length ? `
        <section class="card">
          <div class="card-head"><h3>${groupTitle[g]}</h3><span class="muted">${groups[g].length}</span></div>
          <ul class="cat-list">
            ${groups[g].map(c => `
              <li class="cat-item">
                <span class="cat-icon" style="background:${c.color}22;color:${c.color}">${c.icon}</span>
                <div class="cat-info">
                  <div class="cat-name">${Utils.escapeHtml(c.name)}</div>
                  <div class="muted small">
                    ${counts.get(c.id) || 0} transacciones${c.budget
                      ? ' · Presupuesto: ' + Utils.formatMoney(c.budget, currency) : ''}
                  </div>
                </div>
                <div class="cat-actions">
                  <button class="icon-btn" data-edit="${c.id}" title="Editar" aria-label="Editar">✏️</button>
                  <button class="icon-btn" data-del="${c.id}" title="Eliminar" aria-label="Eliminar">🗑️</button>
                </div>
              </li>`).join('')}
          </ul>
        </section>` : '').join('')}
    `;
    container.querySelector('[data-action="new"]').addEventListener('click',
      () => Forms.categoryForm({ onSaved: () => App.refresh() }));
    container.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => {
      const c = cats.find(x => x.id === b.dataset.edit);
      Forms.categoryForm({ category: c, onSaved: () => App.refresh() });
    }));
    container.querySelectorAll('[data-del]').forEach(b => b.addEventListener('click', async () => {
      const id = b.dataset.del;
      const c = cats.find(x => x.id === id);
      const count = counts.get(id) || 0;
      if (count > 0) {
        UI.toast(`No puedes eliminar "${c.name}": tiene ${count} transacciones asociadas.`, 'error');
        return;
      }
      const ok = await UI.confirm({
        title: 'Eliminar categoría', message: `¿Eliminar "${c.name}"?`,
        confirmText: 'Eliminar', danger: true
      });
      if (!ok) return;
      const r = Store.deleteCategory(id);
      if (r.ok) { UI.toast('Categoría eliminada', 'success'); App.refresh(); }
      else UI.toast('No se pudo eliminar la categoría', 'error');
    }));
  }
  return { render };
})();

/* --- Budgets --- */
Views.budgets = (function () {
  function progressBar(spent, budget) {
    const pct = budget > 0 ? (spent / budget) * 100 : 0;
    const cls = pct >= 100 ? 'danger' : pct >= 80 ? 'warn' : '';
    return `<div class="progress"><div class="progress-bar ${cls}" style="width:${Math.min(100, pct)}%"></div></div>
      <div class="muted small">${pct.toFixed(0)}% usado${
        pct >= 100 ? ' · ¡Excedido!' : pct >= 80 ? ' · Cerca del límite' : ''}</div>`;
  }
  function render(container) {
    const s = Store.getSettings();
    const currency = s.currency;
    const fmt = n => Utils.formatMoney(n, currency);
    const month = Utils.currentMonthKey();
    const totals = new Map(Store.expenseByCategory(month).map(x => [x.categoryId, x.total]));
    const cats = Store.get().categories.filter(c => c.type === 'expense' || c.type === 'both');
    const withBudget = cats.filter(c => c.budget > 0);
    const withoutBudget = cats.filter(c => !(c.budget > 0));
    const totalBudget = withBudget.reduce((a, c) => a + c.budget, 0);
