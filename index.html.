      form.innerHTML = `<div class="field"><label>Presupuesto mensual para ${Utils.escapeHtml(c.name)}</label>
        <input type="number" name="b" min="0" step="0.01"
               value="${c.budget ?? ''}" placeholder="Sin presupuesto"></div>`;
