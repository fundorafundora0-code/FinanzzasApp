            </div>
            ${progressBar(spent, c.budget)}
            <div class="budget-actions"><button class="link" data-edit-budget="${c.id}">Editar presupuesto</button></div>
          </div>`;
        }).join('') : '<p class="muted">Aún no has definido presupuestos por categoría.</p>'}
      </section>
      <section class="card">
        <div class="card-head"><h3>Añadir presupuesto a categorías</h3></div>
        <ul class="cat-list">
          ${withoutBudget.map(c => `<li class="cat-item">
            <span class="cat-icon" style="background:${c.color}22;color:${c.color}">${c.icon}</span>
            <div class="cat-info"><div class="cat-name">${Utils.escapeHtml(c.name)}</div>
              <div class="muted small">Sin presupuesto</div></div>
            <button class="btn btn-ghost" data-edit-budget="${c.id}">Definir</button>
