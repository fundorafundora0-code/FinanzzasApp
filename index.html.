/* --- Reports --- */
Views.reports = (function () {
  function render(container) {
    const s = Store.getSettings();
    const currency = s.currency;
    const fmt = n => Utils.formatMoney(n, currency);
    const now = new Date();
    let month = `${now.getFullYear()}-${Utils.pad(now.getMonth() + 1)}`;
    container.innerHTML = `
      <header class="page-head">
        <div><h1>📈 Reportes</h1><p class="muted">Análisis de tus finanzas</p></div>
        <div class="actions">
          <button class="btn btn-ghost" data-action="csv">⬇ CSV</button>
          <button class="btn btn-ghost" data-action="json">⬇ JSON</button>
          <button class="btn btn-ghost" data-action="import">⬆ Importar JSON</button>
          <button class="btn btn-ghost" data-action="print">🖨 Imprimir</button>
        </div>
      </header>
      <section class="card">
        <div class="filter-row">
          <div class="field"><label>Mes</label><input type="month" id="r-month" value="${month}"></div>
        </div>
      </section>
      <div id="report-body"></div>
    `;
    const monthInput = container.querySelector('#r-month');
    const body = container.querySelector('#report-body');
    function renderMonth() {
      month = monthInput.value || month;
      const totals = Store.monthTotals(month);
      const list = Store.transactionsInMonth(month);
      const catMap = new Map(Store.get().categories.map(c => [c.id, c]));
      const byCat = Store.expenseByCategory(month).map(x => ({
        ...x, cat: catMap.get(x.categoryId) || { name: 'Sin categoría', icon: '🏷️', color: '#94a3b8' }
      }));
      const top5 = byCat.slice(0, 5);
      const daysInMonth = new Date(Number(month.slice(0, 4)), Number(month.slice(5, 7)), 0).getDate();
      const isCurrent = month === Utils.currentMonthKey();
      const elapsedDays = isCurrent ? new Date().getDate() : daysInMonth;
      const dailyAvg = elapsedDays > 0 ? totals.expense / elapsedDays : 0;
      const projection = isCurrent ? dailyAvg * daysInMonth : totals.expense;
      const year = month.slice(0, 4);
      const annual = [];
      for (let m = 1; m <= 12; m++) {
        const mk = `${year}-${Utils.pad(m)}`;
        annual.push({ mk, ...Store.monthTotals(mk) });
      }
      body.innerHTML = `
        <section class="grid stats-grid">
          <div class="stat-card"><div class="stat-label">Ingresos</div><div class="stat-value pos">${fmt(totals.income)}</div></div>
          <div class="stat-card"><div class="stat-label">Gastos</div><div class="stat-value neg">${fmt(totals.expense)}</div></div>
          <div class="stat-card"><div class="stat-label">Balance</div><div class="stat-value ${totals.balance >= 0 ? 'pos' : 'neg'}">${fmt(totals.balance)}</div></div>
          <div class="stat-card"><div class="stat-label">Promedio diario de gasto</div><div class="stat-value">${fmt(dailyAvg)}</div>
            <div class="muted small">${isCurrent ? 'Proyección fin de mes: ' + fmt(projection) : ''}</div></div>
        </section>
        <section class="card">
          <div class="card-head"><h3>Top 5 categorías de gasto</h3></div>
          ${top5.length ? `<ol class="top-list">${top5.map((x, i) => `
            <li><span class="rank">${i + 1}</span>
              <span class="chip" style="background:${x.cat.color}22;color:${x.cat.color}">${x.cat.icon} ${Utils.escapeHtml(x.cat.name)}</span>
              <span class="top-amount">${fmt(x.total)}</span>
            </li>`).join('')}</ol>` : '<p class="muted">Sin gastos en este mes.</p>'}
        </section>
        <section class="card">
          <div class="card-head"><h3>Desglose por categoría</h3></div>
          ${byCat.length ? `<div class="table-wrap"><table class="table">
            <thead><tr><th>Categoría</th><th class="num">Total</th><th class="num">% del gasto</th></tr></thead>
            <tbody>${byCat.map(x => `<tr>
              <td><span class="chip" style="background:${x.cat.color}22;color:${x.cat.color}">${x.cat.icon} ${Utils.escapeHtml(x.cat.name)}</span></td>
              <td class="num">${fmt(x.total)}</td>
              <td class="num">${totals.expense > 0 ? ((x.total / totals.expense) * 100).toFixed(1) : 0}%</td>
            </tr>`).join('')}</tbody>
          </table></div>` : '<p class="muted">Sin datos.</p>'}
        </section>
        <section class="card">
          <div class="card-head"><h3>Resumen anual ${year}</h3></div>
          <div class="table-wrap"><table class="table">
            <thead><tr><th>Mes</th><th class="num">Ingresos</th><th class="num">Gastos</th><th class="num">Balance</th></tr></thead>
            <tbody>${annual.map(a => `<tr>
              <td>${Utils.monthLabel(a.mk)}</td>
              <td class="num pos">${fmt(a.income)}</td>
              <td class="num neg">${fmt(a.expense)}</td>
              <td class="num ${a.balance >= 0 ? 'pos' : 'neg'}">${fmt(a.balance)}</td>
            </tr>`).join('')}</tbody>
            <tfoot><tr><th>Total</th>
              <th class="num">${fmt(annual.reduce((a, x) => a + x.income, 0))}</th>
              <th class="num">${fmt(annual.reduce((a, x) => a + x.expense, 0))}</th>
              <th class="num">${fmt(annual.reduce((a, x) => a + x.balance, 0))}</th>
            </tr></tfoot>
          </table></div>
        </section>
        <section class="card">
          <div class="card-head"><h3>Transacciones del mes</h3><span class="muted">${list.length}</span></div>
          ${list.length ? `<div class="table-wrap"><table class="table">
            <thead><tr><th>Fecha</th><th>Tipo</th><th>Categoría</th><th>Descripción</th><th class="num">Monto</th></tr></thead>
            <tbody>${list.slice().sort((a, b) => a.date.localeCompare(b.date)).map(t => {
              const c = catMap.get(t.categoryId) || { name: 'Sin categoría', icon: '🏷️', color: '#94a3b8' };
              return `<tr>
                <td>${Utils.formatDate(t.date, s.dateFormat)}</td>
                <td>${t.type === 'income' ? 'Ingreso' : 'Gasto'}</td>
                <td><span class="chip" style="background:${c.color}22;color:${c.color}">${c.icon} ${Utils.escapeHtml(c.name)}</span></td>
                <td>${Utils.escapeHtml(t.description || '—')}</td>
                <td class="num ${t.type === 'income' ? 'pos' : 'neg'}">${t.type === 'income' ? '+' : '−'}${fmt(t.amount)}</td>
              </tr>`;
            }).join('')}</tbody>
          </table></div>` : '<p class="muted">Sin transacciones.</p>'}
        </section>
      `;
    }
    monthInput.addEventListener('change', renderMonth);
    renderMonth();
    container.querySelector('[data-action="csv"]').addEventListener('click', () => {
      Utils.download(`fintrack-${Utils.todayISO()}.csv`, Store.exportCSV(), 'text/csv;charset=utf-8');
      UI.toast('CSV exportado', 'success');
    });
    container.querySelector('[data-action="json"]').addEventListener('click', () => {
      Utils.download(`fintrack-${Utils.todayISO()}.json`, Store.exportJSON(), 'application/json');
      UI.toast('JSON exportado', 'success');
    });
    container.querySelector('[data-action="import"]').addEventListener('click', () => {
      const input = document.createElement('input');
      input.type = 'file'; input.accept = 'application/json,.json';
      input.onchange = async () => {
        const file = input.files[0]; if (!file) return;
        try {
          const obj = JSON.parse(await file.text());
          const ok = await UI.confirm({
            title: 'Importar datos',
            message: 'Esto reemplazará TODOS tus datos actuales. ¿Continuar?',
            confirmText: 'Importar', danger: true
          });
          if (!ok) return;
          Store.importJSON(obj);
          UI.toast('Datos importados', 'success');
          App.refresh();
        } catch (e) {
          console.error(e);
          UI.toast('Archivo inválido: ' + e.message, 'error');
        }
      };
      input.click();
    });
    container.querySelector('[data-action="print"]').addEventListener('click', () => window.print());
  }
  return { render };
})();

